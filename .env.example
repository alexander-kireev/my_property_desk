# Local example for My Property Desk.
MPD_SECRET_KEY=replace-with-a-generated-secret-key
MPD_DEBUG=True
MPD_PRODUCTION=False
MPD_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: list exact HTTPS origins and hosts, including the Render hostname.
MPD_CSRF_TRUSTED_ORIGINS=
MPD_HSTS_SECONDS=3600
MPD_REGISTRATION_MODE=instant
MPD_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

MPD_DB_NAME=mpd
MPD_DB_USER=mpd_app
MPD_DB_PASSWORD=replace-with-your-database-password
MPD_DB_HOST=127.0.0.1
MPD_DB_PORT=5432
# Production Neon connections use require; local Postgres can use prefer or disable.
MPD_DB_SSLMODE=prefer

# Local email appears in the runserver console. Configure SMTP in deployment.
MPD_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
MPD_EMAIL_HOST=smtp.example.com
MPD_EMAIL_PORT=587
MPD_EMAIL_HOST_USER=replace-with-smtp-username
MPD_EMAIL_HOST_PASSWORD=replace-with-smtp-password
MPD_EMAIL_USE_TLS=True
MPD_EMAIL_USE_SSL=False
MPD_DEFAULT_FROM_EMAIL=noreply@example.com
MPD_CONTACT_EMAIL=your-inbox@example.com
